<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp" android:layout_height="wrap_content"
    android:layout_marginEnd="14dp" android:orientation="vertical"
    android:focusable="true" android:clickable="true" android:padding="5dp">
    <ImageView android:id="@+id/icon" android:layout_width="match_parent" android:layout_height="84dp" android:scaleType="centerCrop" />
    <TextView android:id="@+id/label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:maxLines="1" android:ellipsize="end" android:paddingTop="5dp"
        android:textColor="@color/text_primary" android:textSize="13sp" />
</LinearLayout>
